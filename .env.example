# =============================================
# RAJESH JEWELLERS BACKEND - ENV CONFIGURATION
# =============================================

# --- REQUIRED FOR LOCAL DEV (fill these first) ---
DATABASE_URL=postgresql+asyncpg://rajesh_user:rajesh_pass@localhost:5432/rajesh_db
# Used by docker-compose.prod.yml to initialize the Postgres container; keep in sync with DATABASE_URL above.
# In production, set a real password here (no default is shipped for the prod compose).
POSTGRES_USER=rajesh_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=rajesh_db
MONGO_URL=mongodb://localhost:27017
MONGO_DB=rajesh_jewellers
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-a-very-long-random-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Comma-separated extra CORS origins (staging domains, a second local dev port, etc).
# FRONTEND_URL is always allowed; leave blank in production unless you need more than one origin.
CORS_EXTRA_ORIGINS=http://localhost:3001

# --- NEEDED BEFORE PRODUCTION (add your own keys) ---

# SMS OTP - MSG91 (get from msg91.com + DLT registration mandatory in India)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Email - SendGrid (get from sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@rajeshjewellers.com

# AWS S3 (product images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=rajesh-jewellers-images

# AI Chat (optional - Groq API for smart chat, get a free key from console.groq.com)
GROQ_API_KEY=

# Chat mode: "faq" works without any key, "llm" needs GROQ_API_KEY
CHAT_MODE=faq
