# Public API base URL, called directly from the end user's browser. Required.
# Local dev:  http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=

# Canonical public site origin (no trailing slash). Used for SEO: canonical URLs,
# sitemap.xml, robots.txt, and Open Graph / structured-data absolute URLs.
# Production example: https://rajeshjewellers.com
# Falls back to https://rajeshjewellers.com when unset.
NEXT_PUBLIC_SITE_URL=

# Optional: server-side-only override for Server Components (app/layout.tsx, app/page.tsx).
# Only needed when the server reaches the backend through a different host than the
# browser does (e.g. an internal Docker service name). Falls back to NEXT_PUBLIC_API_URL
# when unset.
# Docker example: http://api:8000/api/v1
# API_INTERNAL_URL=
